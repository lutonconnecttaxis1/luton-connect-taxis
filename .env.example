# Copy to .env.local for local work:   cp .env.example .env.local
# On Vercel (later), add the same names under Project -> Settings -> Environment Variables.
# NEVER put real values in THIS file and never commit .env.local - this file is only a template.
#
# Status key:  [NOW] needed for the localhost build   [LATER] wired up but only filled in at the end

# -- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until launch. Set to true on the PRODUCTION environment only.
NEXT_PUBLIC_SITE_INDEXABLE=false

# -- Google Maps Platform [NOW] ---------------------------------------------
# Browser key: restricted to HTTP referrers (http://localhost:3000/* for now) and
# to Places API (New) only. Used for address suggestions as you type.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: restricted to Routes API only. Never exposed to the browser.
# Used for the driving distance behind every estimate.
GOOGLE_MAPS_SERVER_API_KEY=

# -- Firebase [NOW] ---------------------------------------------------------
# Web app config (Firebase -> Project settings -> Your apps). Used by accounts (milestone 4).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side access used to SAVE bookings in Firestore (Project settings -> Service accounts
# -> Generate new private key). Keep the private key on ONE line with literal \n, in quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# -- Email: Resend [LATER - last milestone] ---------------------------------
# Until RESEND_API_KEY is set nothing is emailed. On localhost the booking and contact
# messages are printed in the terminal instead, and bookings are still saved to Firestore.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (lutonconnecttaxis.com).
EMAIL_FROM="Luton Connect Taxis <bookings@lutonconnecttaxis.com>"
# Where the office is emailed for every booking request (falls back to config/site.ts).
BOOKING_NOTIFY_EMAIL=admin@lutonconnecttaxis.com

# -- reCAPTCHA v3 [LATER - last milestone] ----------------------------------
# Leave both blank for now: the check is skipped. The honeypot, minimum-fill-time and
# per-IP rate limits already protect the forms in the meantime.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# -- Analytics [LATER - last milestone; loads only after cookie consent] -----
NEXT_PUBLIC_GA_MEASUREMENT_ID=

